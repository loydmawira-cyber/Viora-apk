# ============================================================================
# VIORA ENVIRONMENT TEMPLATE
# Only the THREE values in the first block go into the Android app (.env / AI Studio).
# Anything in the second block must NEVER be put in the app. Anything the app
# reads is built into the APK and can be extracted by anyone.
# ============================================================================

# ---- SAFE FOR THE APP (public by design) ----
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
AGORA_APP_ID=your_agora_app_id_here

# ---- SERVER ONLY: set these with `supabase secrets set NAME=value`, never in the app ----
# SUPABASE_SERVICE_ROLE_KEY=...
# AGORA_APP_CERTIFICATE=...
# FCM_SERVER_KEY=...
# GOOGLE_PLAY_LICENSE_KEY=...
