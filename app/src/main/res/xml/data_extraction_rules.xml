<?xml version="1.0" encoding="utf-8"?>
<!-- Login tokens must never leave the phone via cloud backup or device transfer (Android 12+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="viora_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="viora_session.xml" />
    </device-transfer>
</data-extraction-rules>
